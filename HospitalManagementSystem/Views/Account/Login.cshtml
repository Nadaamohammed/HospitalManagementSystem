@using HospitalManagementSystem.Dto.Account
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5"
     style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">

    <div class="row justify-content-center w-100">
        <div class="col-md-5 col-lg-4">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div style="height:6px;background:linear-gradient(to right,#0d6efd,#0dcaf0);"></div>

                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-3">
                            <i class="fas fa-user-lock fs-3"></i>
                        </div>

                        <h2 class="fw-bold">Login</h2>
                        <p class="text-muted">
                            Sign in to your Hospital Management account
                        </p>
                    </div>

                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label"></label>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter Username" />

                            <span asp-validation-for="UserName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label"></label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter Password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Login
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <span class="text-muted">
                            Don't have an account?
                        </span>

                        <a asp-action="Register"
                               class="text-decoration-none fw-bold">
                            Register
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}