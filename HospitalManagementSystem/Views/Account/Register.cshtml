
@using HospitalManagementSystem.Dto.Account
@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!-- Added a subtle background gradient and min-height to center the card vertically -->
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5"
     style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    
    <div class="row justify-content-center w-100">
        <!-- Adjusted column size for better responsiveness across devices -->
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            
            <!-- Added stronger shadow and smooth border-radius -->
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                
                <!-- Added a colorful top accent line for a premium hospital/brand feel -->
                <div style="height: 6px; background: linear-gradient(to right, #0d6efd, #0dcaf0);"></div>
                
                <div class="card-body p-4 p-sm-5">
                    
                    <!-- Header with an icon placeholder -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-3">
                            <!-- Replace with a Bootstrap Icon like <i class="bi bi-person-plus-fill fs-3"></i> if using BI -->
                            <span class="fs-3 fw-bold">+</span>
                        </div>
                        <h2 class="fw-bold text-dark mb-1">Create Account</h2>
                        <p class="text-muted small">Join the Hospital Management Portal</p>
                    </div>

                    <form asp-action="Register" method="post" autocomplete="off">

                        <!-- Cleaned up validation summary styling -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger rounded-3 small py-2 mb-4" role="alert"></div>
                        }

                        <!-- Name Row (Combines First and Last Name side-by-side on larger screens) -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label small fw-semibold text-secondary"></label>
                                <input asp-for="FirstName" class="form-control form-control-lg rounded-3 fs-6" placeholder="John" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label small fw-semibold text-secondary"></label>
                                <input asp-for="LastName" class="form-control form-control-lg rounded-3 fs-6" placeholder="Doe" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email Input -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3 fs-6" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Username Input -->
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="UserName" class="form-control form-control-lg rounded-3 fs-6" placeholder="johndoe123" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <!-- Password Input -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3 fs-6" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password Input -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg rounded-3 fs-6" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button with Hover effect enhancement -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold shadow-sm py-2 fs-6">
                            Sign Up
                        </button>

                    </form>

                    <!-- Footer Link -->
                    <div class="text-center mt-4 pt-2 border-top">
                        <span class="text-muted small">Already have an account?</span>
                        <a asp-action="Login" class="text-primary fw-semibold small text-decoration-none ms-1">Login here</a>
                    </div>

                </div>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}