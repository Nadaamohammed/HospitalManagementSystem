@using HospitalManagementSystem.Models.Entity
@model IEnumerable<Department>

@{
    ViewData["Title"] = "Departments";
}

<!-- Page Title -->
<div class="page-title">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="heading-title">Departments</h1>

                    <p class="mb-0">
                        Explore our medical departments and healthcare specialties.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="current">Departments</li>
            </ol>
        </div>
    </nav>
</div>

<!-- Departments Section -->
<section id="departments" class="departments section">

    <div class="container" data-aos="fade-up">

        @if (User.IsInRole("Admin"))
        {
            <div class="mb-4">
                <a asp-action="Create"
                       class="btn btn-primary">
                    Add New Department
                </a>
            </div>
        }

        <div class="row g-5">

            @if (Model != null && Model.Any())
            {
                foreach (var department in Model)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">

                        <div class="department-card h-100">

                            <div class="department-icon">
                                <i class="@department.IconClass"></i>
                            </div>

                            <div class="department-image">
                                <img src="@department.ImageUrl"
                                     alt="@department.Name"
                                     class="img-fluid" />
                            </div>

                            <div class="department-content">
                                <h3>@department.Name</h3>

                                <p>@department.Description</p>

                                <div class="mt-3">
                                    <a asp-action="Details"
                                           asp-route-id="@department.Id"
                                           class="btn btn-outline-primary">
                                        Details
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@department.Id"
                                               class="btn btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@department.Id"
                                               class="btn btn-danger">
                                            Delete
                                        </a>
                                    }

                                </div>
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    No departments found.
                </div>
            }
        </div>

    </div>

</section>
